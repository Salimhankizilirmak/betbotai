# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla commit edilmez.

# PostgreSQL (Supabase vb.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# The Odds API (virgülle birden fazla anahtar verilebilir)
ODDS_API_KEYS=
# ODDS_API_KEY=

# Yapay zeka
GEMINI_API_KEYS=
# GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# API-Football (opsiyonel)
API_FOOTBALL_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# X (Twitter) - opsiyonel
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

PORT=8005
